{
  "name": "touch-grass-extension",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "community": "node --env-file-if-exists=.env server/community.mjs",
    "api": "node --env-file-if-exists=.env server/index.mjs",
    "build": "vite build && node scripts/build-extension.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build",
    "package": "npm run check && node scripts/package.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.0",
    "vite": "^6.4.0"
  }
}
