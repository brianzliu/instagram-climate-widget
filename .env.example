# Copy to .env and fill in your own OpenRouter key. Never commit .env.
OPENROUTER_API_KEY=
# Any OpenRouter model that accepts images and structured output.
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional cap on completion tokens per analysis.
OPENROUTER_MAX_TOKENS=5000

# Optional community access for the local analysis backend.
# Use your HTTPS community origin. Loopback HTTP is allowed for local tests.
TOUCH_GRASS_COMMUNITY_URL=
TOUCH_GRASS_SHARE_PROFILE=
TOUCH_GRASS_SHARE_TOKEN=

# Community host only. Mount a persistent disk and assign each approved handle a unique access key.
TOUCH_GRASS_DATA_DIR=
TOUCH_GRASS_PUBLISHERS={}
# PORT=8080
# TOUCH_GRASS_BIND=127.0.0.1
